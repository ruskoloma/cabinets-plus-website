# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.cache/project-import/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# /resources magazine spreads and brochures — these live in S3 under
# library/resources/ and are managed from the TinaCMS media manager. Staging
# them here to preview a rebuild is fine; committing 40 MB of them is not.
/public/library/resources/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

node_modules
.env

./tmp
./tmp/*

# Claude Code
.claude/
